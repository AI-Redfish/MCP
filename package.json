{
  "name": "ai-redfish-tool-collection",
  "version": "0.1.0",
  "description": "工具集合：每个工具都可以以多种方式提供（MCP、CLI，后续可扩展更多方式）。仓库根目录作为启动器（Launcher），根据参数动态加载 tools/ 目录下的各个工具",
  "license": "MIT",
  "bin": {
    "tool-collection": "bin/tool-launcher.js"
  },
  "scripts": {
    "start": "node bin/tool-launcher.js",
    "list": "node bin/tool-launcher.js list",
    "build": "node bin/tool-launcher.js build"
  },
  "engines": {
    "node": ">=18"
  }
}
